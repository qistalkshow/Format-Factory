{
  "name": "formatfactory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-pdf.mjs && node scripts/prepare-media.mjs && vite",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/prepare-pdf.mjs && node scripts/prepare-media.mjs && node scripts/package-app-source.mjs && vite build && node scripts/build-offline.mjs && node scripts/check-size.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "size-check": "node scripts/check-size.mjs",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@xmldom/xmldom": "0.9.12",
    "docx": "9.12.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "imagetracerjs": "1.2.6",
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pptxgenjs": "4.0.1",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  }
}
